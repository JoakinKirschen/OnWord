{
  "name": "onword",
  "version": "1.14.0",
  "private": true,
  "description": "Browser-based word processor. The app itself has no dependencies; these are development tools only.",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p .",
    "check": "node tools/check-architecture.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test \"tests/e2e/*.test.mjs\"",
    "test": "npm run test:unit && npm run test:e2e",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run check && npm test",
    "package": "node tools/package-site.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "playwright": "1.63.0",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
